PORT=4000
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/downtime_tracker

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string
# Access token lifetime
JWT_EXPIRES_IN=15m
# Refresh token (httpOnly cookie) lifetime in days
REFRESH_TOKEN_DAYS=7

# Exact origin of the frontend (used for CORS with credentials)
CORS_ORIGIN=http://localhost:5173

# strict = frontend and API on the same site (default; also true with the Vite dev proxy)
# none   = frontend hosted on a different site (needs HTTPS)
COOKIE_SAMESITE=strict

# --- Neon / deployment ---
# With Neon, `neon deploy` / `neon env pull` writes DATABASE_URL (pooled, used by the running API) and
# DATABASE_URL_UNPOOLED (direct, used by migrations) into ../.env.local at the repository root. The backend reads
# that file automatically and it takes precedence over this one; delete it to go back to the local database.
# DATABASE_URL_UNPOOLED=
# NODE_ENV=production   # enables Secure cookies
# DATABASE_SSL=true     # TLS is switched on automatically for URLs with sslmode=require (Neon); use this for others
#                       # 'no-verify' = TLS without certificate verification (self-signed certificates only)
# ALLOW_REMOTE_RESET=true  # lets db:reset / a wiping seed run against a REMOTE database (refused by default)
# TRUST_PROXY=2         # number of reverse proxies in front of the API (default 1 in production, 0 locally)
