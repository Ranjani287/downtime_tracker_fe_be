# Leave VITE_API_URL empty in development: the app calls /api and the Vite dev server proxies it.
# Set it only when the API is hosted separately (then the backend needs COOKIE_SAMESITE=none and HTTPS).
# VITE_API_URL=https://api.example.com/api

# Where the dev proxy forwards /api (default http://localhost:4000)
# VITE_DEV_PROXY_TARGET=http://localhost:4000
